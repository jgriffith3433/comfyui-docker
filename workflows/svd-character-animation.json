{
  "_meta": {
    "title": "SVD Character Animation",
    "description": "Stable Video Diffusion — generates video frames from a single character image"
  },
  "1": {
    "inputs": {
      "image": "",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": {"title": "Load Input Image"}
  },
  "2": {
    "inputs": {
      "ckpt_name": "svd_xt.safetensors"
    },
    "class_type": "ImageOnlyCheckpointLoader",
    "_meta": {"title": "Load SVD Model"}
  },
  "3": {
    "inputs": {
      "width": 512,
      "height": 512,
      "video_frames": 14,
      "motion_bucket_id": 127,
      "fps": 6,
      "augmentation_level": 0.0,
      "clip_vision": ["2", 1],
      "init_image": ["1", 0],
      "vae": ["2", 2]
    },
    "class_type": "SVD_img2vid_Conditioning",
    "_meta": {"title": "SVD Conditioning"}
  },
  "4": {
    "inputs": {
      "seed": 42,
      "steps": 20,
      "cfg": 2.5,
      "sampler_name": "euler",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["2", 0],
      "positive": ["3", 0],
      "negative": ["3", 1],
      "latent_image": ["3", 2]
    },
    "class_type": "KSampler",
    "_meta": {"title": "Sample Video Frames"}
  },
  "5": {
    "inputs": {
      "samples": ["4", 0],
      "vae": ["2", 2]
    },
    "class_type": "VAEDecode",
    "_meta": {"title": "Decode Frames"}
  },
  "6": {
    "inputs": {
      "filename_prefix": "svd_character",
      "images": ["5", 0]
    },
    "class_type": "SaveImage",
    "_meta": {"title": "Save Frames"}
  }
}
